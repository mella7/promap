# Copy to .env and adjust. Never commit the real .env.

# Which models to use.
#   segmenter: fake | sam2 | planes | sam2_planes (planes need the depth model)
#   depth:     fake | depth_anything_v2
# The real ones need the ml extra (see README).
PROMAP_SEGMENTER=fake
PROMAP_DEPTH=fake

# 1: load the models at startup instead of on the first request. /ready
# answers 503 until they're in. Use it on a server.
PROMAP_PRELOAD=

# The assistant behind /v1/assistant. rules: no language model, free.
PROMAP_ASSISTANT=rules

# Model ids on Hugging Face, and where to run them (cpu or cuda).
PROMAP_SAM_MODEL=facebook/sam2.1-hiera-small
PROMAP_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
PROMAP_DEVICE=cpu

# Photos are shrunk to this many pixels on the long side before SAM sees
# them. Masks come back at full size. Lower is faster.
PROMAP_MODEL_MAX_SIDE=1024
# SAM prompts an N x N grid of points. Time grows with N squared, so 16 is
# about 4x faster than 32 but can miss small things.
PROMAP_SAM_POINTS_PER_SIDE=32
# Drop masks SAM scores below this, and masks with blurrier edges than this.
PROMAP_SAM_MIN_IOU=0.75
PROMAP_SAM_MIN_STABILITY=0.9
# Prompts per batch. 16 needs about 0.5 GB, 64 about 2.5 GB. Same result.
PROMAP_POINTS_PER_BATCH=16

# If set, every request must send this value in the X-API-Key header.
PROMAP_API_KEY=

# Largest accepted upload, in bytes, and largest side of an image, in pixels.
PROMAP_MAX_UPLOAD_BYTES=10000000
PROMAP_MAX_IMAGE_SIDE=4096
