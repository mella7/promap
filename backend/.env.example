# Copy to .env and adjust. Never commit the real .env.

# Which models to use. Only "fake" exists for now.
PROMAP_SEGMENTER=fake
PROMAP_DEPTH=fake

# If set, every request must send this value in the X-API-Key header.
PROMAP_API_KEY=

# Largest accepted upload, in bytes, and largest side of an image, in pixels.
PROMAP_MAX_UPLOAD_BYTES=10000000
PROMAP_MAX_IMAGE_SIDE=4096
